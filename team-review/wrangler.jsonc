{
  "name": "pitchcam-team-review",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pitchcam-team",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "pitchcam-review-frames" },
  ],
}
